# Copy to .env locally. Never commit .env or put real secrets in this file.
# Every Settings variable is listed here; blank values use the documented default.
# Runtime: development or production. Production rejects missing login/encryption config.
ENVIRONMENT=development
# Local SQLite. Compose overrides with PostgreSQL. URL-encode special password characters.
DATABASE_URL=sqlite:///./data/social.db
# Compose only: generate a random alphanumeric local database password.
POSTGRES_PASSWORD=
# Create later: https://social.[company-domain] (no trailing slash).
APP_BASE_URL=
# Create later: https://media.[company-domain] (public, read-only media origin).
MEDIA_BASE_URL=
# Explicit live opt-in: comma-separated linkedin,instagram,facebook,x,tiktok; empty = all dry.
LIVE_PLATFORMS=
# Versioned platform profiles and initial facts (admin saves immutable DB versions).
PROFILES_PATH=config/platforms.yaml
FACTS_PATH=config/facts.seed.yaml
# local or s3. Original bytes, including C2PA/IPTC, are kept unchanged.
STORAGE_BACKEND=local
MEDIA_DIR=data/media
# Drop media then a JSON manifest here; see README for the manifest format.
WATCH_DIR=data/inbox
# S3-compatible storage; prefer workload/instance role credentials in production.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required for storing tokens: Fernet key, or comma-separated new,old keys during rotation.
TOKEN_ENCRYPTION_KEY=
# Required for production/live: random 32+ byte session signing secret.
SESSION_SECRET=
# dev = loopback only. basic = internal/VPN. proxy = trusted SSO proxy with shared secret.
AUTH_MODE=dev
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Proxy must strip incoming auth headers and set X-Authenticated-User and X-Tudelu-Proxy-Secret.
PROXY_AUTH_SECRET=
# Verified/pinned platform API versions; review docs before updating.
META_API_VERSION=v26.0
LINKEDIN_API_VERSION=202609
X_API_VERSION=2
TIKTOK_API_VERSION=v2
# Meta App ID needed for Facebook video's resumable upload API.
META_APP_ID=
# Optional import through `tudelu import-meta`; otherwise enter in Connections UI.
META_SYSTEM_USER_TOKEN=
META_PAGE_ID=
INSTAGRAM_USER_ID=
# Three-legged LinkedIn OAuth. Organization numeric ID, not a member ID.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=
# X confidential web app; OAuth 2.0 PKCE. offline.access is requested.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Keep links off unless desired; current billing must be checked in the X Console.
X_INCLUDE_LINKS=false
# TikTok calls the client ID a client_key. Only inbox upload is implemented.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Optional verified HTTPS domain/prefix; required when transfer=url.
TIKTOK_VERIFIED_URL_PREFIX=
# file or url. File upload works without verified public media prefix.
TIKTOK_TRANSFER=file
# Named internal owner mentioned in the completion alert.
TIKTOK_MANUAL_ASSIGNEE=Tudelu social owner
# fixture = offline deterministic demo; live = actual AI calls with configured keys.
AI_MODE=fixture
# Provider choices requested by Tudelu. These interfaces can be replaced independently.
CAPTION_PROVIDER=anthropic
REVIEW_PROVIDER=anthropic
VISION_PROVIDER=openai
IMAGE_PROVIDER=openai
# Video provider not selected. http supports the documented neutral gateway contract.
VIDEO_PROVIDER=disabled
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_KEY=
# Claude captions + independent fact/brand review. xhigh maps the requested extra effort.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_VERSION=2026-10-21
ANTHROPIC_EFFORT=xhigh
# Includes thinking and answer. Incomplete results are held, never accepted silently.
ANTHROPIC_MAX_TOKENS=16000
# OpenAI API key (a ChatGPT subscription alone is not an API credential).
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# hash = offline similarity fixture; openai required for live publishing.
EMBEDDING_PROVIDER=hash
# Caption disclosure is also included when a native AI field is available.
DISCLOSURE_TEXT=AI-generated or AI-edited media.
# Independent reviewer acceptance and duplicate similarity thresholds (0..1).
REVIEW_MIN_SCORE=0.9
DUPLICATE_THRESHOLD=0.94
DUPLICATE_DAYS=30
# Durable delayed retries. Policy/validation/ambiguous public-write errors are terminal.
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=60
# Single APScheduler worker, durable DB state. Polling does not create per-post memory jobs.
WORKER_INTERVAL_SECONDS=15
CAMPAIGN_STAGGER_MINUTES=20
FAILURE_PAUSE_THRESHOLD=3
HELD_ALERT_THRESHOLD=10
EXPIRY_ALERT_DAYS=14
# Optional alert channels; empty means local admin/log outbox only.
ALERT_SLACK_WEBHOOK=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Network/AI timeouts and maximum ingestion size (bytes).
HTTP_TIMEOUT_SECONDS=30
AI_TIMEOUT_SECONDS=300
MAX_UPLOAD_BYTES=100000000
# Phase 2 read-only metrics. TikTok needs reconnect with video.list; Meta insights scopes required.
ANALYTICS_ENABLED=false
# Advance drafts through generation, gate and scheduling on worker ticks.
AUTO_ADVANCE=true

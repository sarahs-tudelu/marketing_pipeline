# DigitalOcean Droplet deployment. Copy to project-root .env.
# This file contains references and placeholders only, never actual secret values.
GCP_PROJECT_ID=REPLACE_WITH_GCP_PROJECT_ID
ENVIRONMENT=production
AUTH_MODE=basic
ADMIN_USERNAME=admin
LIVE_PLATFORMS=
AI_MODE=fixture
EMBEDDING_PROVIDER=hash
AUTO_ADVANCE=true
ANALYTICS_ENABLED=false

# Replace these reserved .invalid origins after creating DNS records to the Droplet IP.
APP_BASE_URL=https://social.example.invalid
MEDIA_BASE_URL=https://media.example.invalid
TLS_EMAIL=admin@example.invalid
# Company VPN/office public egress CIDRs, separated by spaces. Default denies remote administration.
ADMIN_ALLOWED_CIDRS="127.0.0.1/32 ::1/128"

# Copy nonsecret connection parameters from your existing DigitalOcean Managed PostgreSQL cluster.
# Use the direct database endpoint (not a transaction-pooled endpoint); keep the password separate.
DATABASE_URL=postgresql+psycopg://REPLACE_DB_USER@REPLACE_DB_HOST:REPLACE_DB_PORT/REPLACE_DB_NAME?sslmode=verify-full&sslrootcert=/run/database-certs/REPLACE_CA_FILENAME.pem&connect_timeout=10
# Standard Edition: put the downloaded CA certificate here on the Droplet; mounted read-only.
# Advanced Edition: set sslrootcert=system above and keep this directory present but empty.
DATABASE_CA_HOST_DIR=/etc/tudelu/database-certs
# Store the EXISTING managed database user's password in this secret; do not invent a new password.
DATABASE_PASSWORD=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-database-password/versions/1
STORAGE_BACKEND=local
# Set s3 for a private DigitalOcean Spaces bucket after filling these fields.
# MEDIA_BASE_URL remains the media hostname on the Droplet; the app serves bucket files through it.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
# Enable these references only after creating both secrets and selecting the bucket/region.
# AWS_ACCESS_KEY_ID=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-spaces-access-key-id/versions/1
# AWS_SECRET_ACCESS_KEY=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-spaces-secret-access-key/versions/1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_DIR=/app/data/media
WATCH_DIR=/app/data/inbox
PROFILES_PATH=config/platforms.yaml
FACTS_PATH=config/facts.seed.yaml

# Google Cloud authentication bootstrap lives OUTSIDE this repository.
# Compose binds this host file read-only at GOOGLE_APPLICATION_CREDENTIALS in the app containers.
GCP_ADC_HOST_PATH=/etc/tudelu/google-adc.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google_adc
SECRET_BACKEND=google
SECRET_TIMEOUT_SECONDS=15

# Use numeric secret versions for controlled rollout, especially DB password and Fernet keys.
TOKEN_ENCRYPTION_KEY=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-token-encryption-key/versions/1
SESSION_SECRET=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-session-secret/versions/1
ADMIN_PASSWORD=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-admin-password/versions/1
ANTHROPIC_API_KEY=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-anthropic-api-key/versions/1
OPENAI_API_KEY=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-openai-api-key/versions/1

CAPTION_PROVIDER=anthropic
REVIEW_PROVIDER=anthropic
VISION_PROVIDER=openai
IMAGE_PROVIDER=runway
VIDEO_PROVIDER=runway
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_VERSION=2026-10-21
ANTHROPIC_EFFORT=xhigh
OPENAI_VISION_MODEL=gpt-6-astra
OPENAI_AUDIO_REVIEW_MODEL=gpt-audio-1.5
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
META_API_VERSION=v26.0
LINKEDIN_API_VERSION=202609
X_API_VERSION=2
TIKTOK_API_VERSION=v2

# Optional social-app identifiers; leave blank until the corresponding apps exist.
META_APP_ID=
META_PAGE_ID=
INSTAGRAM_USER_ID=
LINKEDIN_ORGANIZATION_ID=
# OAuth client IDs can be literal values or gsm:// references, just like client secrets.
# X_CLIENT_ID=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-x-client-id/versions/1
LINKEDIN_CLIENT_ID=
X_CLIENT_ID=
TIKTOK_CLIENT_ID=
# Optional secrets: use the references below when those secrets exist; blank does not fetch.
# LINKEDIN_CLIENT_SECRET=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-linkedin-client-secret/versions/1
# X_CLIENT_SECRET=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-x-client-secret/versions/1
# TIKTOK_CLIENT_SECRET=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-tiktok-client-secret/versions/1
# META_SYSTEM_USER_TOKEN=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-meta-system-user-token/versions/1
LINKEDIN_CLIENT_SECRET=
X_CLIENT_SECRET=
TIKTOK_CLIENT_SECRET=
META_SYSTEM_USER_TOKEN=
X_INCLUDE_LINKS=false
TIKTOK_TRANSFER=file
TIKTOK_VERIFIED_URL_PREFIX=
TIKTOK_MANUAL_ASSIGNEE=Tudelu social owner
# ALERT_SLACK_WEBHOOK=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-slack-webhook/versions/1
ALERT_SLACK_WEBHOOK=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_FROM=
SMTP_USERNAME=
# SMTP_PASSWORD=gsm://projects/${GCP_PROJECT_ID}/secrets/tudelu-smtp-password/versions/1
SMTP_PASSWORD=


# Runway media generation; paste a Runway API key here (or a gsm:// reference).
RUNWAY_API_KEY=
# Official Runway API version and supported model identifiers.
RUNWAY_API_VERSION=2024-11-06
RUNWAY_IMAGE_MODEL=gen4_image
RUNWAY_VIDEO_MODEL=gen4.5
RUNWAY_EDIT_MODEL=aleph2
RUNWAY_AUDIO_MODEL=seed_audio
# Maximum saved-task wait and number of background jobs advanced per worker tick.
RUNWAY_TASK_TIMEOUT_SECONDS=3600
MEDIA_JOBS_PER_TICK=4

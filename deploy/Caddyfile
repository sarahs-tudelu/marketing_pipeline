{
	email {$TLS_EMAIL}
	admin off
}

(studio_upstream) {
	reverse_proxy web:8000 {
		header_up -X-Authenticated-User
		header_up -X-Tudelu-Proxy-Secret
	}
}

{$APP_BASE_URL} {
	@internal remote_ip {$ADMIN_ALLOWED_CIDRS}
	handle @internal {
		import studio_upstream
	}
	# Studio checks the CRM session and role on each protected request. Health is an internal probe.
	@crm {
		expression `"{$AUTH_MODE:basic}" == "crm"`
		not path /health /health/
	}
	handle @crm {
		import studio_upstream
	}
	handle {
		respond "Connect to the company VPN or office network to access this resource." 403
	}
	header Strict-Transport-Security "max-age=31536000"
	# Access logging stays disabled to avoid recording OAuth callback query strings.
}

{$MEDIA_BASE_URL} {
	@asset {
		method GET HEAD
		path_regexp asset ^/[a-f0-9]{64}\.(jpg|png|gif|webp|mp4|mov|webm|mp3|wav|m4a|ogg|flac)$
	}
	handle @asset {
		reverse_proxy web:8000 {
			rewrite /media{path}
			header_up -Authorization
			header_up -Cookie
			header_up -X-Authenticated-User
			header_up -X-Tudelu-Proxy-Secret
		}
		header X-Content-Type-Options nosniff
	}
	handle {
		respond "Not found" 404
	}
	header Strict-Transport-Security "max-age=31536000"
}
